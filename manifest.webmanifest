{
  "name": "Be Well Fit — Class Booking",
  "short_name": "Be Well Fit",
  "description": "Choose a fitness, aerial, yoga or dance class at Be Well Fit in Hastings, then send a booking request to the team.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f9f5ed",
  "theme_color": "#42a297",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["health", "fitness", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Book a class",
      "short_name": "Book",
      "url": "./#book",
      "description": "Choose a class, day and time"
    },
    {
      "name": "Timetable",
      "short_name": "Timetable",
      "url": "./#timetable",
      "description": "See this week’s classes"
    }
  ]
}
